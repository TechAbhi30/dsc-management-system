<!DOCTYPE html>
<html>

<head>
    <title>Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body class="bg-light">
    <%- include("partials/navbar") %>

        <div class="container-fluid p-0 mb-5">
            <div class="container-fluid p-0">

                <div class="hero-section">

                    <img src="/images/dashboard.png" class="img-fluid w-100 h-100" style="object-fit:cover;">

                    <div class="hero-overlay"></div>

                    <div class="hero-content">
                        <h2>Digital Signature Certificate Monitoring</h2>
                        <p>Automated monitoring and email alerts for DSC expiry.</p>
                    </div>

                </div>

            </div>
        </div>

        <!-- MASTER DATA UPDATE -->
        <div class="container mt-4">
            <div class="master-data-bar">

                <div>
                    <h6 class="mb-1 fw-bold">
                        <i class="bi bi-file-earmark-excel me-2"></i>
                        Master Employee Data
                    </h6>

                    <small class="text-muted">
                        Upload the latest master Excel file to update employee records.
                    </small>
                </div>

                <form action="/upload-excel" method="POST" enctype="multipart/form-data">
                    <div class="d-flex align-items-center gap-2">

                        <input type="file" name="excelFile" accept=".xlsx,.xls" class="form-control" required>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-upload me-1"></i>
                            Update Data
                        </button>

                    </div>
                </form>

                <form action="/clear-data" method="POST" onsubmit="return confirm('Are you sure you want to clear all employee data and email logs?');">

              <button type="submit" class="btn btn-danger">
                  <i class="bi bi-trash me-1"></i>
                Clear All Data
              </button>

             </form>

            </div>
        </div>

        <!-- STATS -->
        <div class="container mt-5">

            <div class="row g-4">
                <div class="col-md-3">
                    <div class="dsc-card filter-card active-card" data-filter="all">
                        <div class="dsc-icon">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <h5>Total Employees</h5>
                        <h2>
                            <%= total %>
                        </h2>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="dsc-card filter-card " data-filter="expiring">
                        <div class="dsc-icon">
                            <i class="bi bi-exclamation-circle-fill"></i>
                        </div>
                        <h5>Expiring Soon</h5>
                        <h2>
                            <%= expiring %>
                        </h2>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="dsc-card filter-card " data-filter="active">
                        <div class="dsc-icon">
                            <i class="bi bi-patch-check-fill"></i>
                        </div>
                        <h5>Active DSC</h5>
                        <h2>
                            <%= active %>
                        </h2>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="dsc-card filter-card " data-filter="emails">
                        <div class="dsc-icon">
                            <i class="bi bi-envelope-fill"></i>
                        </div>
                        <h5>Email Alerts</h5>
                        <h2>
                            <%= emailsSent %>
                        </h2>
                    </div>
                </div>

            </div>

        </div>


        <!-- EMPLOYEES TABLE -->
        <div class="container mt-5 mb-5">
            <div class="status-card">
                <div class="status-header">
                    <div>
                        <h3 id="tableTitle">
                            All Employees
                        </h3>
                        <div class="title-line"></div>
                    </div>
                    <div>
                        <input type="text" id="searchBox" class="form-control" placeholder="Search employee...">
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>S.No.</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Expiry Date</th>
                                <th>Days Left</th>
                                <th id="lastColumnHeading">Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% employees.forEach((emp,index)=>{ %>
                                <tr data-status="<%= emp.status %>"
                                    data-email="<%= emp.lastEmailSent !== '-' ? 'yes' : 'no' %>"
                                    data-lastemail="<%= emp.lastEmailSent %>">
                                    <td class="serial-number">
                                        <%= index + 1 %>
                                    </td>
                                    <td>
                                        <%= emp.name %>
                                    </td>
                                    <td>
                                        <%= emp.email %>
                                    </td>
                                    <td>
                                        <%= emp.expiryDate %>
                                    </td>
                                    <td>
                                        <% if(emp.status==="Expired" ){ %>
                                            <span class="days-expired">0</span>
                                            <% } else { %>

                                                <%= emp.daysLeft %>

                                                    <% } %>

                                    </td>
                                    <td class="last-column">

                                        <% if(emp.status==="Active" ){ %>

                                            <span class="status-active">
                                                Active
                                            </span>

                                            <% } else if(emp.status==="Expiring Soon" ){ %>
                                                <span class="status-expiring">Expiring Soon</span>

                                                <% } else { %>
                                                    <span class="status-expired">Expired</span>
                                                    <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>

                    </table>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

        <script>
            const lastHeading = document.getElementById("lastColumnHeading");
            const cards = document.querySelectorAll(".filter-card");
            const rows = document.querySelectorAll("tbody tr");
            const title = document.getElementById("tableTitle");
            const searchBox = document.getElementById("searchBox");

            let currentFilter = "all";

            function filterTable() {

                const search = searchBox.value.toLowerCase();

                // Set heading
                if (currentFilter === "emails") {
                    lastHeading.innerText = "Last Email Sent";
                } else if (currentFilter === "active" || currentFilter === "expiring") {
                    lastHeading.innerText = "";
                } else {
                    lastHeading.innerText = "Status";
                }

                let serial = 1;

                rows.forEach(row => {

                    const name = row.children[1].innerText.toLowerCase();
                    const emailText = row.children[2].innerText.toLowerCase();

                    const status = row.dataset.status;
                    const emailed = row.dataset.email;

                    const lastCell = row.querySelector(".last-column");

                    let show = false;

                    // FILTER LOGIC
                    if (currentFilter === "all") show = true;
                    if (currentFilter === "active" && status === "Active") show = true;
                    if (currentFilter === "expiring" && status === "Expiring Soon") show = true;
                    if (currentFilter === "emails" && emailed === "yes") show = true;

                    // SEARCH FILTER
                    if (!(name.includes(search) || emailText.includes(search))) {
                        show = false;
                    }

                    row.style.display = show ? "" : "none";

                    if (show) {

                        // Fix serial number
                        row.querySelector(".serial-number").innerText = serial++;

                        // EMAIL ALERT VIEW
                        if (currentFilter === "emails") {
                            lastCell.style.display = "";
                            lastCell.innerHTML = row.dataset.lastemail || "-";
                        }

                        // ACTIVE / EXPIRING VIEW
                        else if (currentFilter === "active" || currentFilter === "expiring") {
                            lastCell.style.display = "none";
                        }

                        // DEFAULT VIEW
                        else {
                            lastCell.style.display = "";

                            if (status === "Active") {
                                lastCell.innerHTML = '<span class="status-active">Active</span>';
                            } else if (status === "Expiring Soon") {
                                lastCell.innerHTML = '<span class="status-expiring">Expiring Soon</span>';
                            } else {
                                lastCell.innerHTML = '<span class="status-expired">Expired</span>';
                            }
                        }

                    }

                });

            }


            cards.forEach(card => {

                card.addEventListener("click", () => {

                    cards.forEach(c => c.classList.remove("active-card"));

                    card.classList.add("active-card");

                    const filter = card.dataset.filter;
                    currentFilter = filter;
                    const titles = {
                        all: "All Employees",
                        active: "Active Certificates",
                        expiring: "Expiring Certificates",
                        emails: "Employees Notified"
                    };

                    title.innerText = titles[filter];

                    filterTable();

                });

            });
            filterTable();
            searchBox.addEventListener("keyup", filterTable);

        </script>

</body>

</html>